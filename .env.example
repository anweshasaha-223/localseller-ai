# HF_TOKEN: Hugging Face User Access Token (read access).
# Required for running open-weight models via Hugging Face Serverless Inference:
# - Qwen/Qwen2.5-72B-Instruct (Apache 2.0 license, strong multilingual English/Bengali/Hindi)
# - meta-llama/Llama-3.3-70B-Instruct (Llama 3.3 Community License)
# - mistralai/Mistral-7B-Instruct-v0.3 (Apache 2.0 license)
HF_TOKEN="your_huggingface_user_access_token"

# GEMINI_API_KEY: Fallback & Multimodal provider for direct image vision analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000
